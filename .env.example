#  Backend environment 
# Copy this file to .env at the repository root: cp .env.example .env
# The same file is read by docker compose (database) and by Spring Boot (app).

#  PostgreSQL 
POSTGRES_DB=project_management
POSTGRES_USER=pms_user
POSTGRES_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# JWT 
# Base64-encoded 256-bit secret. Generate one with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key
# Token lifetime as an ISO-8601 duration (default 8 hours)
JWT_EXPIRATION=PT8H

# HTTP
# Browser origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Requests per user per minute to the OpenAI-backed endpoints
AI_RATE_LIMIT_PER_MINUTE=10

# OpenAI 
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_open_ai_key

# Bootstrap admin (created only if no ADMIN exists) 
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
