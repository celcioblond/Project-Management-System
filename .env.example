#  Backend environment
# Copy this file to .env at the repository root: cp .env.example .env
# The same file is read by docker compose (database) and by Spring Boot (app).

#  PostgreSQL
POSTGRES_DB=project_management
POSTGRES_USER=pms_user
POSTGRES_PASSWORD=change-me
# Used when the API runs on your machine (./mvnw spring-boot:run); Docker overrides DB_HOST.
# DB_PORT is also the host port Docker publishes PostgreSQL on (bound to 127.0.0.1).
DB_HOST=localhost
DB_PORT=5432

# JWT
# REQUIRED. Base64-encoded 256-bit secret. Generate one with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=PT8H

# HTTP
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Requests per user per minute to the OpenAI-backed endpoints
AI_RATE_LIMIT_PER_MINUTE=10

# OpenAI
# Get your key from https://platform.openai.com/api-keys
# Without a valid key the app still works; only the AI features (chatbot, description and
# diagram generation) return "AI service unavailable".
OPENAI_API_KEY=your_open_ai_key
# Optional chat model (default gpt-4o). Leave commented out to use the default; an empty
# value would override it.
# OPENAI_CHAT_MODEL=gpt-4o

# Bootstrap admin (created on first startup if no ADMIN exists)
# REQUIRED: ADMIN_PASSWORD (8-72 characters). This is the account you log in with first.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=somepass
ADMIN_NAME=System Administrator

# Docker
# Host port for the web app when running with docker compose (http://localhost:8081)
APP_PORT=8081
