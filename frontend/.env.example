# ─── Frontend environment ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values: cp .env.example .env
# Everything prefixed with VITE_ is bundled into the browser build, so it is public:
# never put secrets here. Only needed for `npm run dev`; the Docker image uses /api.

# Base URL of the Spring Boot API
VITE_API_URL=http://localhost:8080/api
